# ==========================================
# WorkDesk - Variables de entorno
# ==========================================

# ------------------------------------------
# Aplicación
# ------------------------------------------

APP_ENV=development
APP_TIMEZONE=America/Santiago


# ------------------------------------------
# Seguridad
# ------------------------------------------

# Clave utilizada por Flask para proteger sesiones
# y otros datos firmados.
#
# Configurar un valor seguro en el archivo .env local.
SECRET_KEY=

# En desarrollo local mediante HTTP debe mantenerse en false.
# En un entorno HTTPS futuro deberá configurarse en true.
SESSION_COOKIE_SECURE=false


# ------------------------------------------
# Base de datos
# ------------------------------------------

# Conexión principal de WorkDesk.
DATABASE_URL=

# Base de datos exclusiva para pytest.
# Nunca debe apuntar a workdesk_dev.
TEST_DATABASE_URL=postgresql+psycopg://workdesk_app:change-me@localhost:5432/workdesk_test


# ------------------------------------------
# Autenticación
# ------------------------------------------

LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15


# ------------------------------------------
# Logging
# ------------------------------------------

LOG_LEVEL=DEBUG
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5