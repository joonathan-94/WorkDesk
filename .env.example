# ==========================================
# WorkDesk - Variables de entorno
# ==========================================

# Entorno de ejecución
APP_ENV=development

# Clave utilizada por Flask para proteger sesiones y otros datos firmados.
# Configurar un valor seguro en el archivo .env local.
SECRET_KEY=

# Conexión a PostgreSQL.
# Se configurará cuando se cree la base de datos de WorkDesk.
DATABASE_URL=

# Zona horaria utilizada por la aplicación.
APP_TIMEZONE=America/Santiago

LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15