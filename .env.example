# ==========================================
# WorkDesk - Variables de entorno
# ==========================================

# ------------------------------------------
# Aplicación
# ------------------------------------------

APP_ENV=development
APP_TIMEZONE=America/Santiago


# ------------------------------------------
# Seguridad
# ------------------------------------------

# Clave utilizada por Flask para proteger sesiones
# y otros datos firmados.
#
# Configurar un valor seguro en el archivo .env local.
SECRET_KEY=

# En desarrollo local mediante HTTP debe mantenerse en false.
# En un entorno HTTPS futuro deberá configurarse en true.
SESSION_COOKIE_SECURE=false


# ------------------------------------------
# Base de datos
# ------------------------------------------

# Conexión principal de WorkDesk.
DATABASE_URL=

# Base de datos exclusiva para pytest.
# Nunca debe apuntar a workdesk_dev.
TEST_DATABASE_URL=postgresql+psycopg://workdesk_app:change-me@localhost:5432/workdesk_test


# ------------------------------------------
# Autenticación
# ------------------------------------------

LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Intentos fallidos desde un mismo equipo (IP), en cualquier cuenta, dentro de
# LOGIN_LOCK_MINUTES, antes de rechazar los siguientes desde ese equipo. Frena a
# quien prueba pocas contraseñas en muchas cuentas. 0 lo desactiva (hazlo si todas
# las peticiones llegan a WorkDesk a través de un mismo proxy).
LOGIN_MAX_FAILED_PER_IP=20

# Opcional, solo desarrollo: contraseña de los usuarios demo para ejecutar
# `seed-demo` sin interacción. Si no se define, el comando la pide al
# ejecutarse. No escribir aquí contraseñas reales.
# WORKDESK_DEMO_PASSWORD=

# Longitud mínima de las contraseñas (entre 8 y 128; 12 recomendado).
PASSWORD_MIN_LENGTH=12

# Límites de sesión: inactividad máxima y duración total.
# Deben ser enteros mayores que cero.
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=8

# Minutos durante los que el autor de un comentario puede editarlo o
# eliminarlo. Debe ser un entero mayor que cero.
COMMENT_EDIT_WINDOW_MINUTES=30

# Días, desde el cierre, durante los que un solicitante puede reabrir su
# ticket (el personal puede siempre). Debe ser un entero mayor que cero.
REOPEN_WINDOW_DAYS=30

# Horas que un ticket puede estar Resuelto sin que su solicitante lo valide
# antes de que el planificador (run-scheduler) lo cierre solo, y cada cuántos
# segundos revisa el planificador cuando se deja en marcha. Enteros mayores
# que cero.
AUTO_CLOSE_HOURS=24
SCHEDULER_INTERVAL_SECONDS=60

# Interruptores: si el SLA se muestra y avisa, y si el planificador cierra solo los
# tickets resueltos sin validar. true o false. El Administrador puede cambiarlos desde
# la web, y entonces su valor reemplaza a estos.
SLA_ENABLED=true
AUTO_CLOSE_ENABLED=true

# Si la ubicación es obligatoria al crear un ticket (solo mientras haya ubicaciones
# activas). El Administrador puede cambiarlo desde «Creación de tickets».
LOCATION_REQUIRED=false

# Advertencia de tickets parecidos al crear uno: días hacia atrás que se revisan (0 la
# desactiva) y palabras del título que deben coincidir (1 a 5).
DUPLICATE_WINDOW_DAYS=30
DUPLICATE_MIN_WORDS=2

# Carga de trabajo: a partir de cuántos tickets activos (ni Resueltos ni Cerrados)
# se marca a un técnico con «carga alta». Solo informa: no bloquea nada. 0 la
# desactiva. Entero mayor o igual que cero.
WORKLOAD_HIGH_ACTIVE_TICKETS=10

# Días sin ninguna acción del personal para contar un ticket en trabajo como «sin actividad
# reciente» en la carga de trabajo. Solo informa. 0 lo desactiva. Entre 0 y 365.
INACTIVE_TICKET_DAYS=7

# Bloqueo temporal de edición de un ticket: segundos que dura sin renovarse y
# cada cuánto lo renueva la pantalla de edición. El latido debe ser menor que
# la duración; ambos, enteros mayores que cero.
EDIT_LOCK_TTL_SECONDS=120
EDIT_LOCK_HEARTBEAT_SECONDS=45

# Adjuntos: tamaño máximo por archivo (bytes, 10 MB por defecto) y cantidad
# máxima de archivos por ticket. Deben ser enteros mayores que cero.
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_FILES_PER_TICKET=20
# Raíz del almacenamiento de adjuntos. Si no se define, instance/uploads.
# UPLOADS_DIR=

# Retención: cada política está apagada hasta que se enciende (también desde
# Administración -> Retención, que manda sobre estos valores). Los tickets, su historial y la
# auditoría se conservan siempre.
RETENTION_NOTIFICATIONS_ENABLED=false
RETENTION_NOTIFICATIONS_DAYS=90
RETENTION_AUTH_EVENTS_ENABLED=false
RETENTION_AUTH_EVENTS_DAYS=365
RETENTION_DELETED_FILES_ENABLED=false
RETENTION_DELETED_FILES_DAYS=90
RETENTION_BACKUPS_ENABLED=false
RETENTION_BACKUPS_KEEP=14

# Carpeta de los respaldos (backup-create). Si no se define, instance/backups. Conviene
# otro disco que el de la base y los adjuntos. No puede estar dentro de static ni dentro
# de UPLOADS_DIR (ni al revés): WorkDesk no arranca así.
# BACKUPS_DIR=

# Carpeta de pg_dump y pg_restore si no están en el PATH, por ejemplo:
# PG_BIN_DIR=C:\Program Files\PostgreSQL\18\bin

# Dónde deja el planificador la hora de su última pasada (la muestra «Estado del sistema»).
# Si no se define, instance/scheduler-heartbeat.json.
# SCHEDULER_HEARTBEAT_FILE=


# ------------------------------------------
# Logging
# ------------------------------------------

LOG_LEVEL=DEBUG
# Carpeta de los logs. Si no se define, instance/logs.
# LOG_DIR=
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5