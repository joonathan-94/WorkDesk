# ==========================================
# WorkDesk - Variables de entorno
# ==========================================

# ------------------------------------------
# Aplicación
# ------------------------------------------

APP_ENV=development
APP_TIMEZONE=America/Santiago


# ------------------------------------------
# Seguridad
# ------------------------------------------

# Clave utilizada por Flask para proteger sesiones
# y otros datos firmados.
#
# Configurar un valor seguro en el archivo .env local.
SECRET_KEY=

# En desarrollo local mediante HTTP debe mantenerse en false.
# En un entorno HTTPS futuro deberá configurarse en true.
SESSION_COOKIE_SECURE=false


# ------------------------------------------
# Base de datos
# ------------------------------------------

# Conexión principal de WorkDesk.
DATABASE_URL=

# Base de datos exclusiva para pytest.
# Nunca debe apuntar a workdesk_dev.
TEST_DATABASE_URL=postgresql+psycopg://workdesk_app:change-me@localhost:5432/workdesk_test


# ------------------------------------------
# Autenticación
# ------------------------------------------

LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Opcional, solo desarrollo: contraseña de los usuarios demo para ejecutar
# `seed-demo` sin interacción. Si no se define, el comando la pide al
# ejecutarse. No escribir aquí contraseñas reales.
# WORKDESK_DEMO_PASSWORD=

# Longitud mínima de las contraseñas (entre 8 y 128; 12 recomendado).
PASSWORD_MIN_LENGTH=12

# Límites de sesión: inactividad máxima y duración total.
# Deben ser enteros mayores que cero.
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=8

# Minutos durante los que el autor de un comentario puede editarlo o
# eliminarlo. Debe ser un entero mayor que cero.
COMMENT_EDIT_WINDOW_MINUTES=30

# Adjuntos: tamaño máximo por archivo (bytes, 10 MB por defecto) y cantidad
# máxima de archivos por ticket. Deben ser enteros mayores que cero.
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_FILES_PER_TICKET=20
# Raíz del almacenamiento de adjuntos. Si no se define, instance/uploads.
# UPLOADS_DIR=


# ------------------------------------------
# Logging
# ------------------------------------------

LOG_LEVEL=DEBUG
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5